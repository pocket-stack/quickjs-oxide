+        Self { index, start: enabled.then(Instant::now) }
+    }
+}
+impl Drop for Timer {
+    #[inline]
+    fn drop(&mut self) {
+        if let Some(start) = self.start {
+            let ns = start.elapsed().as_nanos() as u64;
+            TIMES.with(|c| c[self.index].set(c[self.index].get().saturating_add(ns)));
+            TIMER_CALLS.with(|c| c[self.index].set(c[self.index].get().saturating_add(1)));
+        }
+    }
+}
+pub struct ReportGuard;
+impl ReportGuard {
+    pub fn new() -> Self {
+        let mode = std::env::var("OXIDE_CPU_PROBE").ok().and_then(|s| s.parse::<u8>().ok()).unwrap_or(0);
+        assert!(mode <= 3);
+        MODE.with(|m| m.set(mode));
+        Self
+    }
+}
+impl Drop for ReportGuard {
+    fn drop(&mut self) {
+        let mode = MODE.with(|m| m.replace(0));
+        eprint!("{{\"schema\":\"oxide-cpu-probe-v1\",\"mode\":{},\"counters\":{{", mode);
+        for (i, name) in NAMES.iter().enumerate() {
+            if i != 0 { eprint!(","); }
+            eprint!("\"{}\":{}", name, COUNTERS.with(|c| c[i].get()));
+        }
+        eprint!("}},\"timers\":{{");
+        for (i, name) in NAMES.iter().enumerate() {
+            if i != 0 { eprint!(","); }
+            eprint!("\"{}\":{{\"calls\":{},\"inclusive_ns\":{}}}", name,
+                TIMER_CALLS.with(|c| c[i].get()), TIMES.with(|c| c[i].get()));
+        }
+        eprintln!("}}}}");
+    }
+}
