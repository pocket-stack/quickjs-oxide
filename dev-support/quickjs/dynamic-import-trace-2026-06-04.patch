+/* quickjs-oxide test-only dynamic-import trace protocol (QJODI1).
+ *
+ * The runner explicitly enables tracing before opening inputs, after verifying
+ * that descriptor 3 is a regular file.  We duplicate it once so later fopen()
+ * calls cannot redirect trace output.  All caller-controlled strings are
+ * encoded as byte-length-prefixed hexadecimal, and trace I/O preserves errno.
+ * A write failure terminates this test-only oracle instead of yielding partial
+ * evidence that could be mistaken for a complete trace.
+ */
+#define QJO_TRACE_FD 3
+
+static int qjo_trace_fd = -1;
+static BOOL qjo_trace_enabled;
+
+int qjs_oxide_trace_init(void)
+{
+    const char *enabled = getenv("QJS_OXIDE_DYNAMIC_IMPORT_TRACE");
+    struct stat st;
+    int saved_errno = errno;
+    int flags;
+
+    if (!enabled) {
+        errno = saved_errno;
+        return 0;
+    }
+    if (strcmp(enabled, "1") || fstat(QJO_TRACE_FD, &st) < 0 ||
+        !S_ISREG(st.st_mode))
+        return -1;
+    qjo_trace_fd = dup(QJO_TRACE_FD);
+    if (qjo_trace_fd < 0)
+        return -1;
+    flags = fcntl(qjo_trace_fd, F_GETFD);
+    if (flags < 0 || fcntl(qjo_trace_fd, F_SETFD, flags | FD_CLOEXEC) < 0) {
+        close(qjo_trace_fd);
+        qjo_trace_fd = -1;
+        return -1;
+    }
+    qjo_trace_enabled = TRUE;
+    errno = saved_errno;
+    return 1;
+}
+
+BOOL qjs_oxide_trace_is_enabled(void)
+{
+    return qjo_trace_enabled;
+}
+
+static void qjo_trace_write(const char *buf, size_t len)
+{
+    while (len != 0) {
+        ssize_t ret = write(qjo_trace_fd, buf, len);
+        if (ret > 0) {
+            buf += ret;
+            len -= ret;
+        } else if (ret < 0 && errno == EINTR) {
+            continue;
+        } else {
+            _exit(74);
+        }
+    }
+}
+
+static void qjo_trace_cstr(const char *str)
+{
+    static const char hex[] = "0123456789abcdef";
+    char len_buf[32], encoded[256];
+    size_t len, offset;
+    int len_len;
+
+    if (!str) {
+        qjo_trace_write("-", 1);
+        return;
+    }
+    len = strlen(str);
+    len_len = snprintf(len_buf, sizeof(len_buf), "%zu:", len);
+    if (len_len > 0)
+        qjo_trace_write(len_buf, len_len);
+    for (offset = 0; offset < len;) {
+        size_t i, count = len - offset;
+        if (count > sizeof(encoded) / 2)
+            count = sizeof(encoded) / 2;
+        for (i = 0; i < count; i++) {
+            unsigned char c = (unsigned char)str[offset + i];
+            encoded[i * 2] = hex[c >> 4];
+            encoded[i * 2 + 1] = hex[c & 15];
+        }
+        qjo_trace_write(encoded, count * 2);
+        offset += count;
+    }
+}
 
+static void qjo_trace_normalize(const char *root_name, const char *base_name,
+                                const char *request, const char *normalized)
+{
+    int saved_errno = errno;
+
+    if (qjo_trace_enabled) {
+        qjo_trace_write("QJODI1\tN\t", sizeof("QJODI1\tN\t") - 1);
+        qjo_trace_cstr(root_name);
+        qjo_trace_write("\t", 1);
+        qjo_trace_cstr(base_name);
+        qjo_trace_write("\t", 1);
+        qjo_trace_cstr(request);
+        qjo_trace_write("\t", 1);
+        qjo_trace_cstr(normalized);
+        qjo_trace_write("\n", 1);
+    }
+    errno = saved_errno;
+}
+
+void qjs_oxide_trace_loader(const char *root_name, const char *request,
+                            const char *effective_path, const char *outcome,
+                            int load_errno)
+{
+    char errno_buf[32];
+    int saved_errno = errno;
+    int errno_len;
+
+    if (qjo_trace_enabled) {
+        qjo_trace_write("QJODI1\tL\t", sizeof("QJODI1\tL\t") - 1);
+        qjo_trace_cstr(root_name);
+        qjo_trace_write("\t", 1);
+        qjo_trace_cstr(request);
+        qjo_trace_write("\t", 1);
+        qjo_trace_cstr(effective_path);
+        qjo_trace_write("\t", 1);
+        qjo_trace_cstr(outcome);
+        errno_len = snprintf(errno_buf, sizeof(errno_buf), "\t%d\n", load_errno);
+        if (errno_len > 0)
+            qjo_trace_write(errno_buf, errno_len);
+    }
+    errno = saved_errno;
+}
+
+static void qjo_trace_tla(const char *root_name, const char *module_name,
+                          BOOL has_tla)
+{
+    int saved_errno = errno;
+
+    if (qjo_trace_enabled) {
+        qjo_trace_write("QJODI1\tT\t", sizeof("QJODI1\tT\t") - 1);
+        qjo_trace_cstr(root_name);
+        qjo_trace_write("\t", 1);
+        qjo_trace_cstr(module_name);
+        qjo_trace_write(has_tla ? "\t1\n" : "\t0\n", 3);
+    }
+    errno = saved_errno;
+}
+
